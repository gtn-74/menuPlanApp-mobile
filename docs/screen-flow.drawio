        <!-- JoinGroupScreen -->
        <mxCell id="join-group" value="&lt;b&gt;JoinGroupScreen&lt;/b&gt;&lt;br&gt;グループ参加&lt;br&gt;（招待コード入力）&lt;br&gt;（未実装）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#b3b3b3;fontColor=#999999;fontSize=12;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="280" y="620" width="180" height="70" as="geometry" />
        </mxCell>

        <!-- ===== エッジ（画面遷移） ===== -->

        <!-- 認証: ログイン成功 → メイン -->
        <mxCell id="e-login-main" value="ログイン成功" style="edgeStyle=orthogonalEdgeStyle;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#d6b656;fontColor=#d6b656;fontSize=11;" edge="1" source="login" target="tab-frame" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 認証: ログイン → 新規登録 -->
        <mxCell id="e-login-signup" value="新規登録" style="edgeStyle=orthogonalEdgeStyle;html=1;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#d6b656;fontSize=11;" edge="1" source="login" target="signup" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 認証: ログイン → パスワード忘れた -->
        <mxCell id="e-login-forgot" value="パスワードを忘れた" style="edgeStyle=orthogonalEdgeStyle;html=1;exitX=1;exitY=0.7;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#d6b656;fontSize=11;" edge="1" source="login" target="forgot" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 認証: 新規登録 → ログイン (戻る) -->
        <mxCell id="e-signup-login" value="戻る" style="edgeStyle=orthogonalEdgeStyle;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.3;entryDx=0;entryDy=0;strokeColor=#999999;fontSize=11;dashed=1;" edge="1" source="signup" target="login" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 認証: パスワード忘れた → ログイン (戻る) -->
        <mxCell id="e-forgot-login" value="戻る" style="edgeStyle=orthogonalEdgeStyle;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.7;entryDx=0;entryDy=0;strokeColor=#999999;fontSize=11;dashed=1;" edge="1" source="forgot" target="login" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ログアウト → ログイン -->
        <mxCell id="e-logout" value="ログアウト" style="edgeStyle=orthogonalEdgeStyle;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;strokeColor=#cc0000;fontColor=#cc0000;fontSize=11;" edge="1" source="profile" target="login" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1280" y="780" />
              <mxPoint x="180" y="780" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- カレンダー → プロフィール (モーダル) -->
        <mxCell id="e-cal-profile" value="プロフィールアイコン" style="edgeStyle=orthogonalEdgeStyle;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#9673a6;fontColor=#9673a6;fontSize=11;" edge="1" source="calendar" target="profile" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- カレンダー → 日付詳細ボトムシート -->
        <mxCell id="e-cal-bs" value="日付タップ" style="edgeStyle=orthogonalEdgeStyle;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#b85450;fontColor=#b85450;fontSize=11;" edge="1" source="calendar" target="bs-calendar" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- プロフィール → グループ設定ボトムシート -->
        <mxCell id="e-profile-bs" value="グループ設定タップ" style="edgeStyle=orthogonalEdgeStyle;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#b85450;fontColor=#b85450;fontSize=11;" edge="1" source="profile" target="bs-profile" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 新規登録 → オンボーディング -->
        <mxCell id="e-signup-onboard" value="登録完了" style="edgeStyle=orthogonalEdgeStyle;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#b3b3b3;fontColor=#b3b3b3;fontSize=11;dashed=1;" edge="1" source="signup" target="onboarding" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- オンボーディング → グループ作成 -->
        <mxCell id="e-onboard-setup" value="新しく作る" style="edgeStyle=orthogonalEdgeStyle;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#b3b3b3;fontColor=#b3b3b3;fontSize=11;dashed=1;" edge="1" source="onboarding" target="group-setup" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- オンボーディング → グループ参加 -->
        <mxCell id="e-onboard-join" value="招待コードで参加" style="edgeStyle=orthogonalEdgeStyle;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#b3b3b3;fontColor=#b3b3b3;fontSize=11;dashed=1;" edge="1" source="onboarding" target="join-group" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- グループ作成 → メイン -->
        <mxCell id="e-setup-main" value="作成完了" style="edgeStyle=orthogonalEdgeStyle;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=1;entryDx=0;entryDy=0;strokeColor=#b3b3b3;fontColor=#b3b3b3;fontSize=11;dashed=1;" edge="1" source="group-setup" target="tab-frame" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- グループ参加 → メイン -->
        <mxCell id="e-join-main" value="参加完了" style="edgeStyle=orthogonalEdgeStyle;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=1;entryDx=0;entryDy=0;strokeColor=#b3b3b3;fontColor=#b3b3b3;fontSize=11;dashed=1;" edge="1" source="join-group" target="tab-frame" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 招待リンク → グループ参加（ディープリンク） -->
        <mxCell id="e-invite-join" value="招待リンクを開く" style="edgeStyle=orthogonalEdgeStyle;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;strokeColor=#b3b3b3;fontColor=#b3b3b3;fontSize=11;dashed=1;" edge="1" source="bs-profile" target="join-group" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1300" y="820" />
              <mxPoint x="370" y="820" />
            </Array>
          </mxGeometry>
        </mxCell>

      </root>
    </mxGraphModel>
