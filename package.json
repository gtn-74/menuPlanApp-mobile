{
  "name": "menuplanapp-mobile",
  "version": "0.1.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsgo --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:components": "jest",
    "test:e2e": "playwright test",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test:vrt": "playwright test --config playwright.storybook.config.ts",
    "gen:component": "plop component",
    "prepare": "husky"
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@expo/vector-icons": "^15.0.3",
    "@gorhom/bottom-sheet": "^5.1.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.2.2",
    "@react-navigation/native": "^7.0.15",
    "@react-navigation/native-stack": "^7.2.3",
    "expo": "~54.0.35",
    "expo-asset": "~12.0.13",
    "expo-dev-client": "~6.0.21",
    "expo-font": "~14.0.12",
    "expo-image-picker": "~17.0.11",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-calendars": "^1.1307.0",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "^0.5.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@biomejs/biome": "^2.5.10",
    "@playwright/test": "^1.62.1",
    "@storybook/react-native-web-vite": "^10.5.10",
    "@testing-library/react-native": "13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.1.0",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "babel-preset-expo": "~54.0.10",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.0",
    "lint-staged": "^17.4.1",
    "plop": "^4.0.5",
    "react-test-renderer": "19.1.0",
    "storybook": "^10.5.10",
    "typescript": "~5.9.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "private": true,
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,jsonc}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  }
}
