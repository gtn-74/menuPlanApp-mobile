<mxfile host="app.diagrams.net">
  <diagram name="画面遷移図" id="screen-flow">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ===== セクションラベル ===== -->
        <mxCell id="label-auth" value="認証フロー" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#444444;" vertex="1" parent="1">
          <mxGeometry x="60" y="40" width="120" height="30" as="geometry" />
        </mxCell>
        <mxCell id="label-main" value="メインアプリ" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#444444;" vertex="1" parent="1">
          <mxGeometry x="560" y="40" width="140" height="30" as="geometry" />
        </mxCell>
        <mxCell id="label-sheet" value="ボトムシート" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#444444;" vertex="1" parent="1">
          <mxGeometry x="560" y="440" width="140" height="30" as="geometry" />
        </mxCell>

        <!-- ===== 認証フロー ===== -->

        <!-- LoginScreen -->
        <mxCell id="login" value="&lt;b&gt;LoginScreen&lt;/b&gt;&lt;br&gt;ログイン" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="100" y="200" width="160" height="60" as="geometry" />
        </mxCell>

        <!-- SignUpScreen -->
        <mxCell id="signup" value="&lt;b&gt;SignUpScreen&lt;/b&gt;&lt;br&gt;新規登録" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="340" y="120" width="160" height="60" as="geometry" />
        </mxCell>

        <!-- ForgotPasswordScreen -->
        <mxCell id="forgot" value="&lt;b&gt;ForgotPasswordScreen&lt;/b&gt;&lt;br&gt;パスワードを忘れた" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="320" y="300" width="200" height="60" as="geometry" />
        </mxCell>

        <!-- ===== タブナビゲーター枠 ===== -->
        <mxCell id="tab-frame" value="タブナビゲーター" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;fontColor=#333333;verticalAlign=top;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="560" y="80" width="580" height="320" as="geometry" />
        </mxCell>

        <!-- CalendarScreen (実装済み) -->
        <mxCell id="calendar" value="&lt;b&gt;CalendarScreen&lt;/b&gt;&lt;br&gt;カレンダー" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="590" y="160" width="160" height="60" as="geometry" />
        </mxCell>

        <!-- MenuScreen (未実装) -->
        <mxCell id="menu" value="&lt;b&gt;MenuScreen&lt;/b&gt;&lt;br&gt;献立（未実装）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#b3b3b3;fontColor=#999999;fontSize=12;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="780" y="160" width="160" height="60" as="geometry" />
        </mxCell>

        <!-- BudgetScreen (未実装) -->
        <mxCell id="budget" value="&lt;b&gt;BudgetScreen&lt;/b&gt;&lt;br&gt;家計簿（未実装）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#b3b3b3;fontColor=#999999;fontSize=12;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="590" y="280" width="160" height="60" as="geometry" />
        </mxCell>

        <!-- ScheduleScreen (未実装) -->
        <mxCell id="schedule" value="&lt;b&gt;ScheduleScreen&lt;/b&gt;&lt;br&gt;予定（未実装）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#b3b3b3;fontColor=#999999;fontSize=12;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="780" y="280" width="160" height="60" as="geometry" />
        </mxCell>

        <!-- ProfileScreen (モーダル) -->
        <mxCell id="profile" value="&lt;b&gt;ProfileScreen&lt;/b&gt;&lt;br&gt;プロフィール（モーダル）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1200" y="160" width="160" height="60" as="geometry" />
        </mxCell>

        <!-- ===== ボトムシート ===== -->

        <!-- CalendarScreen BottomSheet -->
        <mxCell id="bs-calendar" value="&lt;b&gt;BottomSheet&lt;/b&gt;&lt;br&gt;日付詳細（DayScheduleList）&lt;br&gt;・献立 / 予定 / 家計 / Todo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="560" y="500" width="220" height="80" as="geometry" />
        </mxCell>

        <!-- ProfileScreen BottomSheet -->
        <mxCell id="bs-profile" value="&lt;b&gt;BottomSheet&lt;/b&gt;&lt;br&gt;グループ設定&lt;br&gt;・グループ名編集&lt;br&gt;・家族メンバー管理&lt;br&gt;・招待リンク" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1200" y="480" width="200" height="100" as="geometry" />
        </mxCell>

        <!-- ===== オンボーディングフロー（未実装） ===== -->
        <mxCell id="label-onboard" value="オンボーディング（未実装）" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#444444;" vertex="1" parent="1">
          <mxGeometry x="60" y="440" width="260" height="30" as="geometry" />
        </mxCell>

        <!-- OnboardingScreen -->
        <mxCell id="onboarding" value="&lt;b&gt;OnboardingScreen&lt;/b&gt;&lt;br&gt;グループ選択&lt;br&gt;（未実装）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#b3b3b3;fontColor=#999999;fontSize=12;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="490" width="180" height="70" as="geometry" />
        </mxCell>

        <!-- GroupSetupScreen -->
        <mxCell id="group-setup" value="&lt;b&gt;GroupSetupScreen&lt;/b&gt;&lt;br&gt;グループ作成&lt;br&gt;（未実装）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#b3b3b3;fontColor=#999999;fontSize=12;dashed=1;" vertex="1" parent="1">
